        <mxCell id="xcchA0hQ13zGNnMLbxfj-9" edge="1" parent="1" source="xcchA0hQ13zGNnMLbxfj-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#82b366;fontSize=13;" target="xcchA0hQ13zGNnMLbxfj-4" value="1 : N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xcchA0hQ13zGNnMLbxfj-10" edge="1" parent="1" source="xcchA0hQ13zGNnMLbxfj-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#d6b656;fontSize=13;" target="xcchA0hQ13zGNnMLbxfj-4" value="1 : N">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xcchA0hQ13zGNnMLbxfj-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Vì sao không lưu trực tiếp N-N?&lt;/b&gt;&lt;br&gt;Một BOOKING có nhiều SEAT và một SEAT có thể xuất hiện trong nhiều BOOKING, nhưng phải phân biệt theo SHOWTIME. Quan hệ trực tiếp không thể biểu diễn đầy đủ khóa suất chiếu và dễ gây Double Booking.&lt;br&gt;&lt;br&gt;Giá ghế có thể thay đổi theo thời gian, nên phải lưu Price/UnitPrice tại TICKET để đóng băng giá lúc mua; không lấy lại từ SEAT.CurrentPrice." vertex="1">
          <mxGeometry height="230" width="560" x="20" y="400" as="geometry" />
        </mxCell>
        <mxCell id="xcchA0hQ13zGNnMLbxfj-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Ràng buộc chống Double Booking&lt;/b&gt;&lt;br&gt;UNIQUE (SeatID, ShowtimeID): một ghế chỉ được bán một lần trong cùng một suất chiếu, nhưng vẫn có thể được bán ở các suất chiếu khác nhau." vertex="1">
          <mxGeometry height="150" width="400" x="1060" y="400" as="geometry" />
        </mxCell>
        <mxCell id="xcchA0hQ13zGNnMLbxfj-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4f8;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;2NF – SeatType&lt;/b&gt;&lt;br&gt;SeatType chỉ phụ thuộc vào SeatID, là một phần của khóa ghép, không phụ thuộc đầy đủ vào toàn bộ khóa chính (SeatID, ShowtimeID). Vì vậy SeatType vi phạm 2NF và phải đặt ở SEAT." vertex="1">
          <mxGeometry height="150" width="400" x="1060" y="590" as="geometry" />
        </mxCell>
